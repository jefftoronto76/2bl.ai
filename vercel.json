{
  "framework": "nextjs",
  "buildCommand": "tsx scripts/sync-branding.ts && next build",
  "outputDirectory": ".next",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "functions": {
    "app/api/media/[id]/retry/route.ts": {
      "maxDuration": 900
    },
    "app/api/media/[id]/start-processing/route.ts": {
      "maxDuration": 900
    },
    "app/api/cron/media-sweep/route.ts": {
      "maxDuration": 900
    }
  },
  "crons": [
    {
      "path": "/api/cron/media-sweep",
      "schedule": "*/5 * * * *"
    }
  ]
}
